{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🔨 Rebuild",
            "type": "shell",
            "command": "podman",
            "args": [
                "run",
                "--rm",
                "-v",
                "${workspaceFolder}/steps/step-0-minimal:/src:z",
                "embedded-gcc",
                "sh",
                "-c",
                "make clean && make -j$(nproc)"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
